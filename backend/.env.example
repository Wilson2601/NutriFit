# Copy this file to ".env" (same folder) and fill in your key, then restart uvicorn.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the vision model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: free USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup).
# Without it the shared DEMO_KEY is used, which has a small hourly limit.
USDA_API_KEY=

# Optional: free key for online recipe search (https://spoonacular.com/food-api).
SPOONACULAR_API_KEY=
